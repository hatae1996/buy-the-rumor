{
  "name": "buy-the-rumor",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "portraits": "python scripts/portrait/build.py",
    "parts": "python scripts/parts/build.py",
    "build:server": "vite build --config vite.server.config.ts",
    "test:deno": "npm run build:server && vitest run --config vitest.deno.config.ts",
    "measure:server": "vitest run --config vitest.measure.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "supabase": "2.118.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
